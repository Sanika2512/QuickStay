<% layout("layouts/boilerplate") %>

<!-- Google Font -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
body {
  font-family: 'Inter', system-ui, sans-serif;
  background: #f7f7f7;
}

/* ===== PAGE WRAPPER ===== */
.listing-page {
  padding: 40px 0;
}

/* ===== CARD ===== */
.listing-card {
  background: #fff;
  border-radius: 18px;
  padding: 40px;
  box-shadow: 0 20px 45px rgba(0,0,0,0.08);
}

/* ===== TITLE ===== */
.listing-title {
  font-size: 1.8rem;
  font-weight: 700;
  margin-bottom: 25px;
}

/* ===== LABELS ===== */
.form-label {
  font-weight: 600;
  margin-bottom: 6px;
}

/* ===== INPUTS ===== */
.form-control {
  height: 50px;
  border-radius: 12px;
  font-size: 0.95rem;
}

textarea.form-control {
  height: auto;
}

.form-control:focus {
  box-shadow: none;
  border-color: #ff385c;
}

/* ===== FILE INPUT ===== */
input[type="file"] {
  padding: 10px;
}

/* ===== ERRORS ===== */
.text-danger {
  font-size: 0.85rem;
  margin-top: 4px;
}

/* ===== BUTTON ===== */
.submit-btn {
  padding: 14px 50px;
  font-size: 1rem;
  font-weight: 600;
  border-radius: 12px;
  background: linear-gradient(to right, #ff385c, #ff5a5f);
  border: none;
  color: #fff;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.submit-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(255,56,92,0.35);
}

/* ===== RESPONSIVE ===== */
@media(max-width:768px){
  .listing-card {
    padding: 30px 20px;
  }
}
</style>

<div class="container listing-page">
  <div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">

      <div class="listing-card">

        <h3 class="listing-title">Create a New Listing</h3>
        
         <!-- ✅ ADD THIS HERE -->
  <% if (errors && errors.length) { %>
    <div class="alert alert-danger mb-4">
      <ul class="mb-0">
        <% errors.forEach(err => { %>
          <li><%= err %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>


        <form method="POST" action="/listings" id="listingForm" enctype="multipart/form-data" novalidate>

          <!-- TITLE -->
          <div class="mb-4">
            <label class="form-label">Title</label>
            <input
               id="title"
               name="listing[title]"
               class="form-control"
                value="<%= listing?.title || '' %>"
                >

            <div class="text-danger" id="titleError"></div>
          </div>

          <!-- DESCRIPTION -->
          <div class="mb-4">
            <label class="form-label">Description</label>
            <textarea
            id="description"
            name="listing[description]"
            class="form-control"
            ><%= listing?.description || '' %></textarea>

            <div class="text-danger" id="descriptionError"></div>
          </div>

          <!-- IMAGE -->
          <div class="mb-4">
            <label class="form-label">Upload Listing Image</label>
            <input 
              name="image"
              type="file"
              class="form-control"
              required
            >
          </div>

          <!-- PRICE + COUNTRY -->
          <div class="row">
            <div class="col-md-6 mb-4">
              <label class="form-label">Price (₹ per night)</label>
             <input
              id="price"
              type="number"
               name="listing[price]"
               class="form-control"
                value="<%= listing?.price || '' %>"
               >

              <div class="text-danger" id="priceError"></div>
            </div>

            <div class="col-md-6 mb-4">
              <label class="form-label">Country</label>
               <input
             id="country"
              name="listing[country]"
             class="form-control"
             value="<%= listing?.country || '' %>"
               >

              <div class="text-danger" id="countryError"></div>
            </div>
          </div>

          <!-- LOCATION -->
          <div class="mb-4">
            <label class="form-label">Location</label>
           <input
             id="location"
            name="listing[location]"
             class="form-control"
            value="<%= listing?.location || '' %>"
              >

            <div class="text-danger" id="locationError"></div>
          </div>

          <!-- BUTTON -->
          <div class="text-center mt-4">
            <button type="submit" class="submit-btn">Add Listing</button>
          </div>

        </form>

      </div>

    </div>
  </div>
</div>

<!-- ===== SAME JS VALIDATION (UNCHANGED) ===== -->
<script>
const form = document.getElementById("listingForm");

form.addEventListener("submit", function(e) {
  let valid = true;

  titleError.textContent = "";
  descriptionError.textContent = "";
  priceError.textContent = "";
  countryError.textContent = "";
  locationError.textContent = "";

  const lettersOnly = /^[A-Za-z\s]+$/;

  if (!title.value.trim()) {
    titleError.textContent = "Title is required";
    valid = false;
  }

  if (!description.value.trim()) {
    descriptionError.textContent = "Description is required";
    valid = false;
  }

  if (!price.value || price.value <= 0) {
    priceError.textContent = "Price must be a positive number";
    valid = false;
  }

  if (!country.value.trim()) {
    countryError.textContent = "Country is required";
    valid = false;
  } else if (!lettersOnly.test(country.value)) {
    countryError.textContent = "Country can contain only letters";
    valid = false;
  }

  if (!location.value.trim()) {
    locationError.textContent = "Location is required";
    valid = false;
  } else if (!lettersOnly.test(location.value)) {
    locationError.textContent = "Location can contain only letters";
    valid = false;
  }

  if (!valid) e.preventDefault();
});
</script>
