<% layout("/layouts/boilerplate") %>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Playfair+Display:wght@700;800;900&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<!-- ================= HERO SECTION ================= -->
<section class="hero">
  <div class="hero-bg" id="hero-bg">
    <!-- Multiple background images for better loading -->
    <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80" alt="Luxury Villa" class="bg-image primary-bg">
    <img src="https://images.unsplash.com/photo-1544551763-46a013bb70d5?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80" alt="Heritage Home" class="bg-image secondary-bg">
  </div>
  
  <div class="hero-gradient"></div>
  
  <div class="hero-content">
    <div class="container">
      <div class="hero-text">
        <div class="tagline">
          <span class="tagline-badge">
            <i class="fas fa-crown"></i>
            Luxury Redefined
          </span>
        </div>
        
        <h1 class="hero-title">
          <span class="line-1">Discover</span>
          <span class="line-2">Extraordinary</span>
          <span class="line-3"></span>
        </h1>
        
        <p class="hero-subtitle">
         
        </p>
        
        <div class="hero-stats">
          <div class="stat-item">
            <div class="stat-icon">
              <i class="fas fa-home"></i>
            </div>
            <div class="stat-content">
              <span class="stat-number">500+</span>
              <span class="stat-label">Premium Stays</span>
            </div>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <div class="stat-icon">
              <i class="fas fa-map-marker-alt"></i>
            </div>
            <div class="stat-content">
              <span class="stat-number">50+</span>
              <span class="stat-label">Cities</span>
            </div>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <div class="stat-icon">
              <i class="fas fa-star"></i>
            </div>
            <div class="stat-content">
              <span class="stat-number">4.9★</span>
              <span class="stat-label">Average Rating</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Search Bar -->
      <div class="search-wrapper">
        <div class="search-container">
          <div class="search-header">
            <div class="search-icon">
              <i class="fas fa-search"></i>
            </div>
            <div class="search-title">
              <h3>Find Your Perfect Stay</h3>
              <p>Search from our curated collection of luxury properties</p>
            </div>
          </div>
          
          <form class="search-form">
            <div class="search-grid">
              <div class="search-field location-field">
                <div class="field-icon">
                  <i class="fas fa-map-marker-alt"></i>
                </div>
                <div class="field-content">
                  <label class="field-label">DESTINATION</label>
                  <input type="text" placeholder="Where do you want to go?">
                  <div class="field-hint">
                    <i class="fas fa-bolt"></i>
                    <span>Popular: Goa, Kerala, Rajasthan</span>
                  </div>
                </div>
              </div>
              
              <div class="search-field date-field">
                <div class="field-icon">
                  <i class="fas fa-calendar"></i>
                </div>
                <div class="field-content">
                  <label class="field-label">CHECK IN</label>
                  <input type="text" placeholder="Select date">
                </div>
                <div class="field-arrow">
                  <i class="fas fa-arrow-right"></i>
                </div>
              </div>
              
              <div class="search-field date-field">
                <div class="field-icon">
                  <i class="fas fa-calendar"></i>
                </div>
                <div class="field-content">
                  <label class="field-label">CHECK OUT</label>
                  <input type="text" placeholder="Select date">
                </div>
              </div>
              
              <div class="search-field guest-field">
                <div class="field-icon">
                  <i class="fas fa-user-friends"></i>
                </div>
                <div class="field-content">
                  <label class="field-label">GUESTS</label>
                  <div class="guest-selector">
                    <span class="guest-count">2 guests</span>
                    <span class="guest-detail">1 bedroom • 2 beds</span>
                  </div>
                </div>
                <div class="field-dropdown">
                  <i class="fas fa-chevron-down"></i>
                </div>
              </div>
              
              <button type="submit" class="search-btn">
                <i class="fas fa-search"></i>
                <span>Search Properties</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= TRUST BADGES ================= -->
<section class="trust-badges">
  <div class="container">
    <div class="section-intro">
      <h2>Why Choose Airnab?</h2>
      <p>Experience luxury stays with our premium services</p>
    </div>
    
    <div class="badge-grid">
      <div class="badge-item">
        <div class="badge-icon">
          <i class="fas fa-shield-alt"></i>
        </div>
        <div class="badge-content">
          <h3>Verified Homes</h3>
          <p>Every property personally inspected for quality</p>
        </div>
        <div class="badge-arrow">
          <i class="fas fa-arrow-right"></i>
        </div>
      </div>
      
      <div class="badge-item">
        <div class="badge-icon">
          <i class="fas fa-star"></i>
        </div>
        <div class="badge-content">
          <h3>Premium Quality</h3>
          <p>4.9+ average rating from 10,000+ reviews</p>
        </div>
        <div class="badge-arrow">
          <i class="fas fa-arrow-right"></i>
        </div>
      </div>
      
      <div class="badge-item">
        <div class="badge-icon">
          <i class="fas fa-headset"></i>
        </div>
        <div class="badge-content">
          <h3>24/7 Support</h3>
          <p>Dedicated concierge service available</p>
        </div>
        <div class="badge-arrow">
          <i class="fas fa-arrow-right"></i>
        </div>
      </div>
      
      <div class="badge-item">
        <div class="badge-icon">
          <i class="fas fa-gem"></i>
        </div>
        <div class="badge-content">
          <h3>Luxury Amenities</h3>
          <p>Premium facilities & exclusive services</p>
        </div>
        <div class="badge-arrow">
          <i class="fas fa-arrow-right"></i>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= FEATURED LISTINGS ================= -->
<section class="featured-listings">
  <div class="container">
    <div class="section-header">
      <div class="header-left">
        <h2 class="section-title">
          <span class="title-icon">
            <i class="fas fa-crown"></i>
          </span>
          Featured Luxury Stays
        </h2>
        <p class="section-subtitle">
          Most loved properties by our luxury travelers
        </p>
      </div>
      <a href="/listings" class="view-all-btn">
        <span>View all properties</span>
        <i class="fas fa-arrow-right"></i>
      </a>
    </div>

    <div class="listings-grid">
      <% featuredListings.forEach((listing, index) => { %>
      <div class="listing-card">
        <a href="/listings/<%= listing._id %>" class="card-link">
          <div class="card-image">
            <img src="<%= listing.image.url %>" alt="<%= listing.title %>" onerror="this.src='https://images.unsplash.com/photo-1613490493576-7fde63acd811?ixlib=rb-4.0.3&auto=format&fit=crop&w=2071&q=80'">
            <div class="card-badges">
              <span class="badge badge-featured">
                <i class="fas fa-star"></i>
                FEATURED
              </span>
              <% if (listing.category === 'luxury') { %>
              <span class="badge badge-luxury">
                <i class="fas fa-gem"></i>
                LUXURY
              </span>
              <% } %>
            </div>
            <button class="wishlist-btn">
              <i class="far fa-heart"></i>
            </button>
          </div>
          
          <div class="card-content">
            <div class="card-header">
              <h3 class="card-title"><%= listing.title %></h3>
              <div class="card-rating">
                <div class="rating-stars">
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star-half-alt"></i>
                </div>
                <span>4.<%= Math.floor(Math.random() * 9) %></span>
                <span class="rating-count">(<%= Math.floor(Math.random() * 200) + 50 %> reviews)</span>
              </div>
            </div>
            
            <p class="card-location">
              <i class="fas fa-map-marker-alt"></i>
              <%= listing.location || 'Premium Location' %>
            </p>
            
            <div class="card-features">
              <span class="feature">
                <i class="fas fa-bed"></i>
                <%= listing.bedrooms || 2 %> beds
              </span>
              <span class="feature">
                <i class="fas fa-bath"></i>
                <%= listing.bathrooms || 2 %> baths
              </span>
              <span class="feature">
                <i class="fas fa-ruler-combined"></i>
                <%= Math.floor(Math.random() * 1000) + 1000 %> sq.ft
              </span>
            </div>
            
            <div class="card-amenities">
              <% const amenities = ['wifi', 'snowflake', 'parking', 'swimming-pool']; %>
              <% amenities.forEach(amenity => { %>
              <span class="amenity" title="<%= amenity === 'wifi' ? 'WiFi' : amenity === 'snowflake' ? 'Air Conditioning' : amenity === 'parking' ? 'Free Parking' : 'Swimming Pool' %>">
                <i class="fas fa-<%= amenity %>"></i>
              </span>
              <% }) %>
            </div>
            
            <div class="card-footer">
              <div class="price">
                <div class="price-main">
                  <span class="price-amount">₹<%= listing.price.toLocaleString("en-IN") %></span>
                  <span class="price-period">/ night</span>
                </div>
                <span class="price-note">+ taxes & fees</span>
              </div>
              <div class="card-action">
                <span class="action-text">View Details</span>
                <i class="fas fa-arrow-right"></i>
              </div>
            </div>
          </div>
        </a>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ================= EXPERIENCE TYPES ================= -->
