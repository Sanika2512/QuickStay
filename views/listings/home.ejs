<!-- ================= STYLES ================= -->
<style>
:root {
  --primary: #FF385C;
  --primary-dark: #E31C5F;
  --primary-light: #FF6B9D;
  --secondary: #222222;
  --accent: #00A699;
  --accent-light: #33B9AD;
  --accent-dark: #008489;
  --light: #FFFFFF;
  --light-gray: #F7F7F7;
  --gray: #DDDDDD;
  --dark-gray: #717171;
  --text-dark: #1A1A1A;
  --text-light: #666666;
  --text-lighter: #999999;
  
  --gradient-primary: linear-gradient(135deg, #FF385C 0%, #FF6B9D 100%);
  --gradient-secondary: linear-gradient(135deg, #00A699 0%, #00C9B8 100%);
  --gradient-dark: linear-gradient(135deg, #222222 0%, #444444 100%);
  --gradient-gold: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  
  --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.05);
  --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.12);
  --shadow-lg: 0 20px 60px rgba(0, 0, 0, 0.15);
  --shadow-xl: 0 25px 80px rgba(0, 0, 0, 0.2);
  
  --radius-sm: 12px;
  --radius-md: 16px;
  --radius-lg: 24px;
  --radius-xl: 32px;
  --radius-2xl: 48px;
  
  --transition: all 0.3s ease;
  --transition-slow: all 0.5s ease;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Poppins', sans-serif;
  background: var(--light);
  color: var(--text-dark);
  overflow-x: hidden;
  line-height: 1.6;
}

.container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 40px;
}

/* ================= HERO SECTION - FIXED ================= */
.hero {
  height: 90vh;
  min-height: 700px;
  max-height: 900px;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 1s ease-in-out;
}

.primary-bg {
  opacity: 1;
  z-index: 1;
}

.secondary-bg {
  opacity: 0;
  z-index: 2;
}

.hero-gradient {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0.7) 0%,
    rgba(0, 0, 0, 0.5) 50%,
    rgba(0, 0, 0, 0.7) 100%
  );
  z-index: 3;
}

.hero-content {
  position: relative;
  z-index: 10;
  width: 100%;
  padding: 40px 0;
}

.tagline {
  margin-bottom: 20px;
  text-align: center;
}

.tagline-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 24px;
  background: var(--gradient-gold);
  color: #222;
  font-weight: 600;
  border-radius: var(--radius-xl);
  font-size: 14px;
  letter-spacing: 0.5px;
  box-shadow: 0 4px 15px rgba(255, 215, 0, 0.3);
}

.hero-text {
  text-align: center;
  margin-bottom: 50px;
  padding: 0 20px;
}

.hero-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.8rem, 7vw, 5rem);
  font-weight: 900;
  color: var(--light);
  margin-bottom: 20px;
  line-height: 1.1;
  position: relative;
}

.hero-title span {
  display: block;
}

.hero-title .line-3 {
  color: var(--primary);
  position: relative;
  display: inline-block;
  padding: 0 10px;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
}

.hero-subtitle {
  font-size: clamp(1.2rem, 2vw, 1.6rem);
  color: rgba(255, 255, 255, 0.95);
  max-width: 700px;
  margin: 0 auto 40px;
  font-weight: 400;
  line-height: 1.5;
}

.hero-stats {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 30px;
  flex-wrap: wrap;
  margin-top: 40px;
  padding: 20px;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  border-radius: var(--radius-lg);
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 0;
}

.stat-icon {
  width: 40px;
  height: 40px;
  background: var(--gradient-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--light);
  font-size: 16px;
}

.stat-content {
  display: flex;
  flex-direction: column;
}

.stat-number {
  font-size: 1.8rem;
  font-weight: 800;
  color: var(--light);
  margin-bottom: 2px;
  line-height: 1;
}

.stat-label {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.9);
  text-transform: uppercase;
  letter-spacing: 1px;
  font-weight: 600;
}

.stat-divider {
  width: 1px;
  height: 30px;
  background: rgba(255, 255, 255, 0.3);
}

/* Search Wrapper */
.search-wrapper {
  max-width: 1000px;
  margin: 0 auto;
  padding: 0 20px;
}

.search-container {
  background: rgba(255, 255, 255, 0.98);
  border-radius: var(--radius-2xl);
  padding: 30px;
  box-shadow: var(--shadow-xl);
  border: 1px solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10px);
}

.search-header {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 30px;
}

.search-icon {
  width: 50px;
  height: 50px;
  background: var(--gradient-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--light);
  font-size: 20px;
}

.search-title h3 {
  font-size: 1.5rem;
  color: var(--text-dark);
  margin-bottom: 5px;
  font-weight: 700;
}

.search-title p {
  color: var(--text-light);
  font-size: 14px;
}

.search-form {
  width: 100%;
}

.search-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 20px;
}

.search-field {
  background: var(--light-gray);
  border-radius: var(--radius-lg);
  padding: 18px 20px;
  display: flex;
  align-items: center;
  gap: 15px;
  transition: var(--transition);
  border: 2px solid transparent;
  position: relative;
}

.search-field:hover {
  background: var(--light);
  border-color: var(--gray);
  transform: translateY(-2px);
}

.search-field:focus-within {
  background: var(--light);
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(255, 56, 92, 0.1);
}

.field-icon {
  color: var(--primary);
  font-size: 18px;
  min-width: 20px;
}

.field-content {
  flex: 1;
  min-width: 0;
}

.field-label {
  display: block;
  font-size: 11px;
  font-weight: 700;
  color: var(--dark-gray);
  margin-bottom: 6px;
  text-transform: uppercase;
  letter-spacing: 0.8px;
}

.field-content input {
  width: 100%;
  background: transparent;
  border: none;
  font-family: 'Poppins', sans-serif;
  font-size: 15px;
  color: var(--text-dark);
  outline: none;
  font-weight: 500;
  padding: 4px 0;
}

.field-content input::placeholder {
  color: var(--dark-gray);
  opacity: 0.7;
  font-weight: 400;
}

.field-hint {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--text-lighter);
  margin-top: 6px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.field-hint i {
  color: var(--primary);
  font-size: 10px;
}

.field-arrow {
  color: var(--text-lighter);
  font-size: 14px;
  margin-left: 10px;
}

.field-dropdown {
  color: var(--text-lighter);
  font-size: 14px;
  margin-left: 10px;
}

.guest-selector {
  display: flex;
  flex-direction: column;
}

.guest-count {
  font-size: 15px;
  color: var(--text-dark);
  font-weight: 500;
}

.guest-detail {
  font-size: 11px;
  color: var(--text-lighter);
  margin-top: 4px;
}

.search-btn {
  grid-column: 1 / -1;
  background: var(--gradient-primary);
  border: none;
  border-radius: var(--radius-lg);
  padding: 20px 30px;
  color: var(--light);
  font-family: 'Poppins', sans-serif;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  transition: var(--transition);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  letter-spacing: 0.5px;
  margin-top: 10px;
}

.search-btn:hover {
  background: var(--primary-dark);
  transform: translateY(-3px);
  box-shadow: 0 10px 30px rgba(255, 56, 92, 0.3);
}

/* ================= TRUST BADGES ================= */
.trust-badges {
  padding: 80px 0;
  background: linear-gradient(135deg, #fafafa 0%, #ffffff 100%);
  position: relative;
  overflow: hidden;
}

.trust-badges::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: var(--gradient-primary);
}

.section-intro {
  text-align: center;
  margin-bottom: 60px;
}

.section-intro h2 {
  font-family: 'Playfair Display', serif;
  font-size: 3rem;
  font-weight: 900;
  color: var(--text-dark);
  margin-bottom: 15px;
}

.section-intro p {
  font-size: 1.2rem;
  color: var(--text-light);
  max-width: 600px;
  margin: 0 auto;
}

.badge-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 30px;
}

.badge-item {
  background: var(--light);
  border-radius: var(--radius-lg);
  padding: 30px;
  display: flex;
  align-items: center;
  gap: 20px;
  transition: var(--transition);
  border: 1px solid rgba(0, 0, 0, 0.05);
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
}

.badge-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  background: var(--gradient-primary);
  opacity: 0;
  transition: var(--transition);
}

.badge-item:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-md);
  border-color: rgba(255, 56, 92, 0.2);
}

.badge-item:hover::before {
  opacity: 1;
}

.badge-icon {
  width: 70px;
  height: 70px;
  background: var(--gradient-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--light);
  font-size: 28px;
  flex-shrink: 0;
}

.badge-content {
  flex: 1;
}

.badge-content h3 {
  font-size: 1.3rem;
  color: var(--text-dark);
  margin-bottom: 8px;
  font-weight: 700;
}

.badge-content p {
  color: var(--text-light);
  font-size: 14px;
  line-height: 1.5;
}

.badge-arrow {
  color: var(--text-lighter);
  font-size: 14px;
  opacity: 0;
  transform: translateX(-10px);
  transition: var(--transition);
}

.badge-item:hover .badge-arrow {
  opacity: 1;
  transform: translateX(0);
}

/* ================= FEATURED LISTINGS ================= */
.featured-listings {
  padding: 100px 0;
  background: linear-gradient(135deg, #ffffff 0%, #f9f9f9 100%);
  position: relative;
}

.featured-listings::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: var(--gradient-primary);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 60px;
}

.header-left {
  flex: 1;
}

.section-title {
  font-family: 'Playfair Display', serif;
  font-size: 3.2rem;
  font-weight: 900;
  color: var(--text-dark);
  margin-bottom: 15px;
  display: flex;
  align-items: center;
  gap: 15px;
}

.title-icon {
  width: 60px;
  height: 60px;
  background: var(--gradient-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--light);
  font-size: 24px;
}

.section-subtitle {
  font-size: 1.2rem;
  color: var(--text-light);
  max-width: 600px;
}

.view-all-btn {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 16px 30px;
  background: var(--light);
  color: var(--primary);
  text-decoration: none;
  font-weight: 700;
  border-radius: var(--radius-lg);
  border: 2px solid var(--primary);
  transition: var(--transition);
  white-space: nowrap;
}

.view-all-btn:hover {
  background: var(--primary);
  color: var(--light);
  transform: translateX(5px);
  box-shadow: 0 10px 30px rgba(255, 56, 92, 0.2);
}

.listings-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
  gap: 35px;
}

.listing-card {
  background: var(--light);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: var(--transition);
  box-shadow: var(--shadow-md);
  position: relative;
  border: 1px solid rgba(0, 0, 0, 0.05);
}

.listing-card:hover {
  transform: translateY(-10px);
  box-shadow: var(--shadow-xl);
  border-color: rgba(255, 56, 92, 0.2);
}

.card-link {
  text-decoration: none;
  color: inherit;
  display: block;
}

.card-image {
  position: relative;
  height: 280px;
  overflow: hidden;
}

.card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.listing-card:hover .card-image img {
  transform: scale(1.08);
}

.card-badges {
  position: absolute;
  top: 20px;
  left: 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  align-items: flex-start;
}

.badge {
  padding: 8px 16px;
  border-radius: var(--radius-md);
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.badge-featured {
  background: var(--gradient-primary);
  color: var(--light);
}

.badge-luxury {
  background: var(--gradient-gold);
  color: #222;
}

.wishlist-btn {
  position: absolute;
  top: 20px;
  right: 20px;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  border: none;
  color: var(--text-dark);
  font-size: 18px;
  cursor: pointer;
  transition: var(--transition);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(5px);
}

.wishlist-btn:hover {
  background: var(--light);
  color: var(--primary);
  transform: scale(1.1);
}

.card-content {
  padding: 25px;
}

.card-header {
  margin-bottom: 15px;
}

.card-title {
  font-size: 1.4rem;
  font-weight: 700;
  line-height: 1.3;
  color: var(--text-dark);
  margin-bottom: 10px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-rating {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.rating-stars {
  color: var(--primary);
  font-size: 14px;
}

.card-rating span {
  font-weight: 600;
  color: var(--text-dark);
}

.rating-count {
  color: var(--text-lighter);
  font-weight: 400;
  font-size: 14px;
}

.card-location {
  color: var(--text-light);
  font-size: 15px;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.card-features {
  display: flex;
  gap: 20px;
  margin-bottom: 20px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--light-gray);
}

.feature {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--text-light);
  font-size: 14px;
  font-weight: 500;
}

.feature i {
  color: var(--primary);
}

.card-amenities {
  display: flex;
  gap: 12px;
  margin-bottom: 20px;
}

.amenity {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: var(--light-gray);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-light);
  font-size: 14px;
  transition: var(--transition);
  cursor: help;
  position: relative;
}

.amenity:hover {
  background: var(--primary);
  color: var(--light);
  transform: translateY(-2px);
}

.amenity:hover::after {
  content: attr(title);
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  background: var(--text-dark);
  color: white;
  padding: 6px 12px;
  border-radius: 6px;
  font-size: 12px;
  white-space: nowrap;
  margin-bottom: 8px;
  z-index: 100;
}

.amenity:hover::before {
  content: '';
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  border: 6px solid transparent;
  border-top-color: var(--text-dark);
  margin-bottom: 2px;
  z-index: 100;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price {
  display: flex;
  flex-direction: column;
}

.price-main {
  display: flex;
  align-items: baseline;
  gap: 5px;
}

.price-amount {
  font-size: 1.8rem;
  font-weight: 800;
  color: var(--text-dark);
  line-height: 1;
}

.price-period {
  color: var(--text-light);
  font-size: 14px;
}

.price-note {
  font-size: 12px;
  color: var(--text-lighter);
  margin-top: 4px;
}

.card-action {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--primary);
  font-weight: 600;
  font-size: 15px;
  transition: var(--transition);
}

.listing-card:hover .card-action {
  transform: translateX(5px);
}

/* ================= EXPERIENCE TYPES ================= */
.experience-types {
  padding: 100px 0;
  background: var(--light);
}

.experience-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 30px;
}

.experience-card {
  border-radius: var(--radius-lg);
  padding: 30px;
  position: relative;
  overflow: hidden;
  transition: var(--transition);
  cursor: pointer;
  border: 1px solid rgba(0, 0, 0, 0.05);
}

.experience-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  opacity: 0;
  transition: var(--transition);
}

.experience-card:hover {
  transform: translateY(-8px);
  box-shadow: var(--shadow-lg);
}

.experience-card:hover::before {
  opacity: 1;
}

.exp-icon {
  width: 80px;
  height: 80px;
  background: var(--light);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 25px;
  font-size: 32px;
  transition: var(--transition);
  position: relative;
  z-index: 2;
}

.exp-content {
  position: relative;
  z-index: 2;
}

.experience-card h3 {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 10px;
  color: var(--text-dark);
}

.experience-card p {
  color: var(--text-light);
  margin-bottom: 15px;
  font-size: 15px;
  line-height: 1.5;
}

.exp-count {
  display: inline-block;
  padding: 8px 20px;
  background: rgba(255, 255, 255, 0.2);
  color: var(--light);
  border-radius: 20px;
  font-size: 14px;
  font-weight: 700;
  backdrop-filter: blur(10px);
}

/* Experience Card Colors */
.card-beach {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.card-beach::before { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
.card-beach .exp-icon { color: #667eea; }

.card-mountain {
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
  color: white;
}

.card-mountain::before { background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); }
.card-mountain .exp-icon { color: #11998e; }

.card-nature {
  background: linear-gradient(135deg, #00b09b 0%, #96c93d 100%);
  color: white;
}

.card-nature::before { background: linear-gradient(135deg, #00b09b 0%, #96c93d 100%); }
.card-nature .exp-icon { color: #00b09b; }

.card-heritage {
  background: linear-gradient(135deg, #f46b45 0%, #eea849 100%);
  color: white;
}

.card-heritage::before { background: linear-gradient(135deg, #f46b45 0%, #eea849 100%); }
.card-heritage .exp-icon { color: #f46b45; }

.card-luxury {
  background: linear-gradient(135deg, #ff416c 0%, #ff4b2b 100%);
  color: white;
}

.card-luxury::before { background: linear-gradient(135deg, #ff416c 0%, #ff4b2b 100%); }
.card-luxury .exp-icon { color: #ff416c; }

.card-pet {
  background: linear-gradient(135deg, #654ea3 0%, #da98b4 100%);
  color: white;
}

.card-pet::before { background: linear-gradient(135deg, #654ea3 0%, #da98b4 100%); }
.card-pet .exp-icon { color: #654ea3; }

.card-pool {
  background: linear-gradient(135deg, #2193b0 0%, #6dd5ed 100%);
  color: white;
}

.card-pool::before { background: linear-gradient(135deg, #2193b0 0%, #6dd5ed 100%); }
.card-pool .exp-icon { color: #2193b0; }

.card-loft {
  background: linear-gradient(135deg, #373b44 0%, #4286f4 100%);
  color: white;
}

.card-loft::before { background: linear-gradient(135deg, #373b44 0%, #4286f4 100%); }
.card-loft .exp-icon { color: #373b44; }

/* ================= HOST CTA ================= */
.host-cta {
  padding: 100px 0;
  background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%);
  color: var(--light);
  position: relative;
  overflow: hidden;
}

.host-cta::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('https://images.unsplash.com/photo-1518780664697-55e3ad937233?q=80&w=2065&auto=format&fit=crop') center/cover;
  opacity: 0.1;
}

.cta-content {
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
  position: relative;
  z-index: 2;
}

.cta-text h2 {
  font-family: 'Playfair Display', serif;
  font-size: 3.2rem;
  font-weight: 900;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
}

.cta-icon {
  width: 60px;
  height: 60px;
  background: var(--gradient-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
}

.cta-text p {
  font-size: 1.2rem;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 50px;
  max-width: 700px;
  margin-left: auto;
  margin-right: auto;
  line-height: 1.6;
}

.cta-features {
  display: flex;
  justify-content: center;
  gap: 30px;
  flex-wrap: wrap;
  margin-bottom: 50px;
}

.feature {
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 20px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-lg);
  border: 1px solid rgba(255, 255, 255, 0.2);
  min-width: 250px;
  backdrop-filter: blur(10px);
  transition: var(--transition);
}

.feature:hover {
  background: rgba(255, 255, 255, 0.15);
  transform: translateY(-5px);
}

.feature-icon {
  width: 50px;
  height: 50px;
  background: var(--gradient-primary);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
}

.feature-text {
  text-align: left;
}

.feature-text h4 {
  font-size: 1.1rem;
  margin-bottom: 5px;
  font-weight: 700;
}

.feature-text p {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 0;
}

.cta-actions {
  display: flex;
  gap: 20px;
  justify-content: center;
  flex-wrap: wrap;
}

.cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 18px 40px;
  font-size: 16px;
  font-weight: 700;
  text-decoration: none;
  border-radius: var(--radius-lg);
  transition: var(--transition);
  border: none;
  cursor: pointer;
  font-family: 'Poppins', sans-serif;
}

.btn-primary {
  background: var(--gradient-primary);
  color: var(--light);
}

.btn-primary:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 40px rgba(255, 56, 92, 0.3);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.1);
  color: var(--light);
  border: 2px solid rgba(255, 255, 255, 0.3);
}

.btn-secondary:hover {
  background: rgba(255, 255, 255, 0.2);
  transform: translateY(-5px);
  border-color: rgba(255, 255, 255, 0.5);
}

/* ================= RESPONSIVE ================= */
@media (max-width: 1200px) {
  .container {
    padding: 0 30px;
  }
  
  .listings-grid {
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 30px;
  }
  
  .experience-grid {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }
}

@media (max-width: 992px) {
  .hero {
    height: 85vh;
    min-height: 650px;
  }
  
  .search-grid {
    grid-template-columns: 1fr 1fr;
  }
  
  .search-btn {
    grid-column: 1 / -1;
  }
  
  .section-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  
  .view-all-btn {
    align-self: flex-start;
  }
  
  .cta-features {
    flex-direction: column;
    align-items: center;
  }
  
  .feature {
    width: 100%;
    max-width: 400px;
  }
}

@media (max-width: 768px) {
  .hero {
    height: auto;
    min-height: 600px;
    padding: 40px 0;
  }
  
  .hero-title {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
  }
  
  .hero-subtitle {
    font-size: 1.1rem;
  }
  
  .hero-stats {
    flex-direction: column;
    gap: 15px;
    padding: 15px;
  }
  
  .stat-item {
    width: 100%;
    justify-content: center;
  }
  
  .stat-divider {
    display: none;
  }
  
  .search-grid {
    grid-template-columns: 1fr;
  }
  
  .badge-grid {
    grid-template-columns: 1fr;
  }
  
  .listings-grid {
    grid-template-columns: 1fr;
  }
  
  .section-title {
    font-size: 2.5rem;
  }
  
  .experience-grid {
    grid-template-columns: 1fr 1fr;
  }
  
  .experience-card {
    padding: 25px 20px;
  }
  
  .exp-icon {
    width: 60px;
    height: 60px;
    font-size: 24px;
    margin-bottom: 20px;
  }
  
  .experience-card h3 {
    font-size: 1.3rem;
  }
  
  .cta-actions {
    flex-direction: column;
    align-items: center;
  }
  
  .cta-btn {
    width: 100%;
    max-width: 300px;
    justify-content: center;
  }
}

@media (max-width: 576px) {
  .container {
    padding: 0 20px;
  }
  
  .hero {
    min-height: 550px;
  }
  
  .hero-title {
    font-size: clamp(2.2rem, 5vw, 2.8rem);
  }
  
  .hero-subtitle {
    font-size: 1rem;
    margin-bottom: 30px;
  }
  
  .search-container {
    padding: 20px;
  }
  
  .section-title {
    font-size: 2rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  
  .title-icon {
    width: 50px;
    height: 50px;
    font-size: 20px;
  }
  
  .experience-grid {
    grid-template-columns: 1fr;
  }
  
  .feature {
    min-width: 100%;
  }
}

/* Animation for hero background */
@keyframes zoomIn {
  0% { transform: scale(1); }
  100% { transform: scale(1.05); }
}

.primary-bg {
  animation: zoomIn 20s ease-in-out infinite alternate;
}

/* Smooth transitions */
.listing-card,
.experience-card,
.badge-item {
  cursor: pointer;
}

/* Loading state for images */
.bg-image.loading {
  filter: blur(10px);
}

.bg-image.loaded {
  filter: blur(0);
  transition: filter 0.5s ease;
}
</style>

<!-- ================= ENHANCED SCRIPTS ================= -->
<script>
// Hero background image loader and rotator
const heroBg = document.getElementById('hero-bg');
const bgImages = heroBg.querySelectorAll('.bg-image');
let currentBgIndex = 0;

// Preload images
function preloadImages() {
  const imageUrls = [
    'https://images.unsplash.com/photo-1566073771259-6a8506099945?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
    'https://images.unsplash.com/photo-1544551763-46a013bb70d5?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
    'https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
    'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80'
  ];
  
  imageUrls.forEach(url => {
    const img = new Image();
    img.src = url;
  });
}

// Rotate background images
function rotateBackground() {
  // Fade out current image
  bgImages[currentBgIndex].style.opacity = '0';
  
  // Update index
  currentBgIndex = (currentBgIndex + 1) % bgImages.length;
  
  // Fade in next image
  setTimeout(() => {
    bgImages[currentBgIndex].style.opacity = '1';
  }, 1000);
}

// Start background rotation after 8 seconds
setTimeout(() => {
  rotateBackground();
  setInterval(rotateBackground, 8000);
}, 8000);

// Preload images on page load
window.addEventListener('DOMContentLoaded', preloadImages);

// Enhanced wishlist toggle with animation
document.querySelectorAll('.wishlist-btn').forEach(btn => {
  btn.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    const icon = btn.querySelector('i');
    
    // Create ripple effect
    const ripple = document.createElement('span');
    const rect = btn.getBoundingClientRect();
    const size = Math.max(rect.width, rect.height);
    const x = e.clientX - rect.left - size / 2;
    const y = e.clientY - rect.top - size / 2;
    
    ripple.style.cssText = `
      position: absolute;
      border-radius: 50%;
      background: rgba(255, 56, 92, 0.3);
      transform: scale(0);
      animation: ripple 0.6s linear;
      width: ${size}px;
      height: ${size}px;
      top: ${y}px;
      left: ${x}px;
      pointer-events: none;
    `;
    
    btn.appendChild(ripple);
    
    // Toggle wishlist state
    btn.classList.toggle('active');
    if (btn.classList.contains('active')) {
      icon.classList.replace('far', 'fas');
      btn.style.color = '#FF385C';
      btn.style.transform = 'scale(1.2)';
      
      // Show toast notification
      showToast('Added to wishlist!', 'success');
    } else {
      icon.classList.replace('fas', 'far');
      btn.style.color = '';
      btn.style.transform = 'scale(1)';
      showToast('Removed from wishlist!', 'info');
    }
    
    setTimeout(() => {
      btn.style.transform = '';
      ripple.remove();
    }, 600);
  });
});

// Add ripple animation to CSS
const style = document.createElement('style');
style.textContent = `
  @keyframes ripple {
    to {
      transform: scale(4);
      opacity: 0;
    }
  }
`;
document.head.appendChild(style);

// Toast notification function
function showToast(message, type = 'success') {
  const toast = document.createElement('div');
  toast.className = 'toast-notification';
  toast.textContent = message;
  
  const colors = {
    success: '#4CAF50',
    info: '#2196F3',
    warning: '#FF9800',
    error: '#F44336'
  };
  
  toast.style.cssText = `
    position: fixed;
    top: 20px;
    right: 20px;
    background: ${colors[type] || colors.success};
    color: white;
    padding: 14px 28px;
    border-radius: 12px;
    font-weight: 600;
    z-index: 10000;
    animation: slideIn 0.3s ease;
    box-shadow: 0 8px 25px rgba(0,0,0,0.2);
    max-width: 300px;
    word-wrap: break-word;
    line-height: 1.5;
  `;
  
  document.body.appendChild(toast);
  
  setTimeout(() => {
    toast.style.animation = 'slideOut 0.3s ease';
    setTimeout(() => toast.remove(), 300);
  }, 3000);
}

// Add slide animations
const slideStyle = document.createElement('style');
slideStyle.textContent = `
  @keyframes slideIn {
    from {
      transform: translateX(100%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }
  
  @keyframes slideOut {
    from {
      transform: translateX(0);
      opacity: 1;
    }
    to {
      transform: translateX(100%);
      opacity: 0;
    }
  }
`;
document.head.appendChild(slideStyle);

// Search form functionality
document.querySelectorAll('.search-field input').forEach(input => {
  input.addEventListener('focus', function() {
    this.parentElement.parentElement.classList.add('focused');
  });
  
  input.addEventListener('blur', function() {
    this.parentElement.parentElement.classList.remove('focused');
  });
});

// Date field functionality (simplified)
const dateFields = document.querySelectorAll('.date-field input');
const today = new Date();
const tomorrow = new Date(today);
tomorrow.setDate(tomorrow.getDate() + 1);

dateFields[0].value = today.toLocaleDateString('en-US', { 
  month: 'short', 
  day: 'numeric',
  year: 'numeric'
});

dateFields[1].value = tomorrow.toLocaleDateString('en-US', { 
  month: 'short', 
  day: 'numeric',
  year: 'numeric'
});

// Guest selector functionality
const guestField = document.querySelector('.guest-field');
const guestCount = document.querySelector('.guest-count');
const guestDetail = document.querySelector('.guest-detail');

guestField.addEventListener('click', function(e) {
  if (!e.target.closest('.field-dropdown')) return;
  
  const guests = prompt('Enter number of guests (1-10):', '2');
  if (guests && guests >= 1 && guests <= 10) {
    guestCount.textContent = `${guests} guest${guests > 1 ? 's' : ''}`;
    const bedrooms = Math.ceil(guests / 2);
    guestDetail.textContent = `${bedrooms} bedroom${bedrooms > 1 ? 's' : ''} • ${guests} bed${guests > 1 ? 's' : ''}`;
  }
});

// Smooth scroll for anchor links
document.querySelectorAll('a[href^="#"]').forEach(anchor => {
  anchor.addEventListener('click', function (e) {
    e.preventDefault();
    const targetId = this.getAttribute('href');
    if (targetId === '#') return;
    
    const targetElement = document.querySelector(targetId);
    if (targetElement) {
      window.scrollTo({
        top: targetElement.offsetTop - 100,
        behavior: 'smooth'
      });
    }
  });
});

// Card hover effects
document.querySelectorAll('.listing-card, .experience-card, .badge-item').forEach(card => {
  card.addEventListener('mouseenter', () => {
    card.style.zIndex = '100';
  });
  
  card.addEventListener('mouseleave', () => {
    card.style.zIndex = '1';
  });
});

// Parallax effect for hero (optional)
window.addEventListener('scroll', () => {
  const scrolled = window.pageYOffset;
  const hero = document.querySelector('.hero');
  if (scrolled < hero.offsetHeight) {
    const rate = scrolled * -0.5;
    hero.style.transform = `translate3d(0px, ${rate}px, 0px)`;
  }
});

// Image lazy loading
const imageObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      const img = entry.target;
      if (img.dataset.src) {
        img.src = img.dataset.src;
        img.classList.add('loaded');
      }
      imageObserver.unobserve(img);
    }
  });
}, {
  rootMargin: '50px'
});

// Observe all listing images
document.querySelectorAll('.card-image img').forEach(img => {
  if (!img.src.includes('data:')) {
    img.classList.add('loaded');
  }
  imageObserver.observe(img);
});

// Form submission
document.querySelector('.search-form').addEventListener('submit', function(e) {
  e.preventDefault();
  
  const destination = this.querySelector('.location-field input').value;
  const checkIn = this.querySelectorAll('.date-field input')[0].value;
  const checkOut = this.querySelectorAll('.date-field input')[1].value;
  const guests = this.querySelector('.guest-count').textContent;
  
  if (!destination) {
    showToast('Please enter a destination!', 'warning');
    return;
  }
  
  showToast(`Searching for stays in ${destination}...`, 'info');
  
  // Simulate search delay
  setTimeout(() => {
    window.location.href = `/listings?destination=${encodeURIComponent(destination)}&checkin=${checkIn}&checkout=${checkOut}&guests=${guests}`;
  }, 1500);
});

// Initialize page animations
window.addEventListener('load', () => {
  document.body.classList.add('loaded');
  
  // Animate stats counter
  const statNumbers = document.querySelectorAll('.stat-number');
  statNumbers.forEach(stat => {
    const target = stat.textContent;
    stat.textContent = '0';
    
    const animateCounter = () => {
      const current = parseInt(stat.textContent);
      const increment = Math.ceil(parseInt(target.replace('+', '').replace('★', '')) / 100);
      
      if (current < parseInt(target.replace('+', '').replace('★', ''))) {
        stat.textContent = current + increment;
        setTimeout(animateCounter, 20);
      } else {
        stat.textContent = target;
      }
    };
    
    // Start animation after a delay
    setTimeout(animateCounter, 500);
  });
});

// Add keyboard navigation
document.addEventListener('keydown', (e) => {
  // Focus search on Ctrl/Cmd + K
  if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
    e.preventDefault();
    document.querySelector('.location-field input').focus();
  }
  
  // Submit form on Enter when focused on search inputs
  if (e.key === 'Enter' && e.target.matches('.search-field input')) {
    document.querySelector('.search-form').dispatchEvent(new Event('submit'));
  }
});

// Add tooltips for amenities
document.querySelectorAll('.amenity').forEach(amenity => {
  amenity.addEventListener('mouseenter', (e) => {
    // Tooltip is already handled by CSS
  });
});
</script> 