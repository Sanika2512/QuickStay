<% layout("/layouts/boilerplate") %>

<!-- Font Awesome -->
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
/>

<style>
/* ================= PAGE WRAPPER ================= */
.signup-container {
    min-height: calc(100vh - 120px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    background: #f7f7f7;
    margin-top: 30px;
    margin-bottom: 40px;
}

/* ================= MAIN CARD ================= */
.main-content {
    width: 100%;
    max-width: 1200px;
    display: flex;
    gap: 40px;
}

/* ================= LEFT HERO IMAGE ================= */
.left-side {
    flex: 1;
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    min-height: 620px;

    background-image: url("https://images.unsplash.com/photo-1749523130207-11ed85de963e?q=80&w=1400&auto=format&fit=crop");
    background-size: cover;
    background-position: center;
}

/* OVERLAY */
.left-side::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to bottom,
        rgba(0,0,0,0.35),
        rgba(0,0,0,0.65)
    );
    z-index: 1;
}

/* LEFT CONTENT */
.stats-content {
    position: relative;
    z-index: 2;
    height: 100%;
    padding: 50px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}
.stats-title {
    font-size: 3rem;
    font-weight: 800;
    color: #fff;
    max-width: 90%;
    line-height: 1.2;
}


.stats-container {
    display: flex;
    justify-content: space-between;
    gap: 20px;
}

.stat-item {
    text-align: center;
    color: #fff;
}

.stat-number {
    font-size: 2.2rem;
    font-weight: 800;
}

.stat-label {
    font-size: 0.95rem;
    opacity: 0.9;
}

/* ================= RIGHT FORM ================= */
.right-side {
    flex: 1;
    background: #fff;
    border-radius: 24px;
    padding: 55px;
    box-shadow: 0 25px 50px rgba(0,0,0,0.08);
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.form-header {
    text-align: center;
    margin-bottom: 40px;
}

.form-title {
    font-size: 2rem;
    font-weight: 700;
}

.form-subtitle {
    color: #666;
    margin-top: 6px;
}

.signup-form {
    display: flex;
    flex-direction: column;
    gap: 22px;
}

.form-group label {
    font-weight: 600;
    margin-bottom: 8px;
    display: flex;
    gap: 8px;
    align-items: center;
}

.form-control-custom {
    width: 100%;
    padding: 15px;
    border-radius: 14px;
    border: 1.5px solid #ddd;
    font-size: 1rem;
}

.form-control-custom:focus {
    outline: none;
    border-color: #ff385c;
}

.signup-button-custom {
    margin-top: 25px;
    padding: 16px;
    border-radius: 14px;
    border: none;
    background: linear-gradient(to right,#ff385c,#ff5a5f);
    color: #fff;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.signup-button-custom:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(255,56,92,0.35);
}

/* ================= MOBILE ================= */
@media (max-width: 900px) {
    .main-content {
        flex-direction: column;
    }

    .left-side {
        min-height: 420px;
    }

    .stats-title {
        font-size: 2.2rem;
    }

    .right-side {
        padding: 40px 30px;
    }
}
</style>

<div class="signup-container">
    <div class="main-content">

        <!-- LEFT IMAGE SECTION -->
        <div class="left-side">
            <div class="stats-content">
                <h1 class="stats-title">Reserve Your Ideal Holiday</h1>

                <div class="stats-container">
                    <div class="stat-item">
                        <div class="stat-number">115k+</div>
                        <div class="stat-label">Happy Travelers</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-number">70k+</div>
                        <div class="stat-label">Destinations</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-number">47k+</div>
                        <div class="stat-label">5-Star Reviews</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT FORM SECTION -->
        <div class="right-side">
            <div class="form-header">
                <h2 class="form-title">Sign Up on Wanderlust</h2>
                <p class="form-subtitle">Join our community of travelers and hosts</p>
            </div>

            <form action="/signup" method="POST" class="signup-form">
                <div class="form-group">
                    <label><i class="fas fa-user"></i> Username</label>
                    <input
                        type="text"
                        name="username"
                        class="form-control-custom"
                        required
                        placeholder="Choose a username"
                    >
                </div>

                <div class="form-group">
                    <label><i class="fas fa-envelope"></i> Email</label>
                    <input
                        type="email"
                        name="email"
                        class="form-control-custom"
                        required
                        placeholder="Enter your email address"
                    >
                </div>

                <div class="form-group">
                    <label><i class="fas fa-lock"></i> Password</label>
                    <input
                        type="password"
                        name="password"
                        class="form-control-custom"
                        required
                        placeholder="Create a strong password"
                    >
                </div>

                <button class="signup-button-custom">Sign Up</button>
            </form>
        </div>

    </div>
</div>
